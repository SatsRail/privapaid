{
  "name": "privapaid",
  "version": "0.9.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:decryption": "vitest run tests/integration/decryption-e2e tests/integration/pages tests/unit/components/PaymentWall.real-crypto.test.tsx",
    "prepare": "husky",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "deploy": "bash scripts/deploy-demo.sh",
    "verify:sentry-dsn": "bash scripts/verify-sentry-dsn-inlined.sh",
    "cleanup:orphan-envelopes": "tsx scripts/cleanup-orphan-envelopes.ts",
    "audit:media-envelopes": "tsx scripts/audit-media-envelopes.ts",
    "repair:media-products": "tsx scripts/repair-media-products.ts"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@prisma/client": "^6.0.0",
    "@sentry/nextjs": "^10.45.0",
    "bcryptjs": "^3.0.3",
    "dompurify": "^3.4.12",
    "file-type": "^21.3.3",
    "marked": "^18.0.3",
    "next": "^16.2.11",
    "next-auth": "5.0.0-beta.32",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sharp": "^0.35.3",
    "swr": "^2.4.1",
    "web-push": "^3.6.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testcontainers/postgresql": "^12.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/dompurify": "^3.0.5",
    "@types/dotenv": "^6.1.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-istanbul": "^4.1.0",
    "dotenv": "^17.3.1",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "husky": "^9.1.7",
    "jsdom": "^29.0.1",
    "lint-staged": "^16.4.0",
    "prisma": "^6.0.0",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "vitest": "^4.1.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix"
    ]
  },
  "overrides": {
    "sharp": "^0.35.3",
    "postcss": ">=8.5.18",
    "flatted": ">=3.4.2",
    "yaml": ">=2.8.3",
    "js-yaml": ">=4.2.1 <5",
    "undici": ">=7.27.3 <8",
    "vite": ">=8.0.16",
    "protobufjs": ">=7.6.5 <8",
    "fast-uri": ">=3.1.4 <4",
    "minimatch@3": {
      "brace-expansion": "1.1.16"
    },
    "minimatch@5": {
      "brace-expansion": "2.1.2"
    },
    "minimatch@9": {
      "brace-expansion": "5.0.8"
    },
    "minimatch@>=10": {
      "brace-expansion": "5.0.8"
    },
    "micromatch": {
      "picomatch": ">=2.3.2"
    },
    "lint-staged": {
      "picomatch": ">=4.0.4"
    },
    "vitest": {
      "picomatch": ">=4.0.4"
    }
  }
}
