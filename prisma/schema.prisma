// PrivaPaid Stream — PostgreSQL schema
//
// Migration from MongoDB/Mongoose. See plan:
// /Users/rafael/.claude/plans/privapaid-app-uses-mongodb-we-precious-harbor.md
//
// Product/blob flattening: see plan:
// /Users/rafael/.claude/plans/privapaid-in-the-app-cryptic-russell.md
//
// Hard constraints:
//   1. SatsRail always holds the encryption keys (never in this DB).
//   2. Encrypted blob format must stay byte-identical:
//        Base64( IV[12] + ciphertext + auth_tag[16] ), AAD = satsrailProductId.
//   3. external_ref format `ch_<channel.ref>` / `md_<media.ref>` is opaque to
//      the portal but must survive unchanged.
//   4. MediaEnvelope.wrappedDek (the per-media DEK wrapped under CONTENT_KEK)
//      is the operator recovery store. Key rotation unwraps it directly, so
//      rotation doesn't depend on SatsRail's old_key. No plaintext at rest.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [citext]
}

// ── Enums ──────────────────────────────────────────────────────────────────

enum AdminRole {
  owner
  admin
  moderator
}

enum AuditActorType {
  admin
  system
}

enum MediaType {
  video
  audio
  article
  photo
  podcast
}

/// Decryptability health of a Media row. `error` is set ONLY after a
/// server-confirmed content-integrity failure (see api/media/[id]/report-error):
/// it blocks the viewer page and skips all portal/unlock work until an admin
/// clears it (Mark resolved) or a re-encrypt fixes the blob. NOT the portal
/// product status (active/inactive/archived) — that lives on Product.
enum MediaStatus {
  ok
  error
}

/// Role of a MediaImage row: the single thumbnail or one of the preview-gallery
/// images for a Media item.
enum MediaImageKind {
  thumbnail
  preview
}

// ── Models ─────────────────────────────────────────────────────────────────

/// Admin — team display + role assignment. Auth handled by SatsRail.
model Admin {
  id           String    @id @default(cuid())
  email        String    @unique @db.Citext
  passwordHash String
  name         String
  role         AdminRole @default(admin)
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

/// Category — content taxonomy.
model Category {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique @db.Citext
  position  Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  channels Channel[]

  @@index([position])
  @@index([active])
}

/// Channel — content source, has many Media.
model Channel {
  id                    String    @id @default(cuid())
  ref                   Int       @unique @default(autoincrement()) // emitted as `ch_<ref>` to portal
  slug                  String    @unique @db.Citext
  satsrailProductTypeId String?
  name                  String
  bio                   String    @default("")
  categoryId            String?
  nsfw                  Boolean   @default(false)
  // Flat object: { youtube, twitter, discord, instagram, tiktok, website }.
  // Never sub-queried — keep as JSON.
  socialLinks           Json      @default("{}")
  profileImageUrl       String    @default("")
  profileImageBytes     Bytes? // replaces GridFS pointer
  profileImageMimeType  String?
  isLive                Boolean   @default(false)
  streamUrl             String    @default("")
  active                Boolean   @default(true)
  /// Denormalized count of associated Media. Updated via { increment: 1 }
  /// in the same transaction as Media create/delete.
  mediaCount            Int       @default(0)
  deletedAt             DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  category          Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  media             Media[]
  products          Product[]
  pushSubscriptions PushSubscription[]

  @@index([categoryId])
  @@index([active])
  @@index([createdAt(sort: Desc)])
}

/// Media — one of video/audio/article/photo/podcast.
model Media {
  id              String      @id @default(cuid())
  ref             Int         @unique @default(autoincrement()) // emitted as `md_<ref>` to portal
  channelId       String
  name            String
  description     String      @default("")
  mediaType       MediaType   @default(video)
  position        Int         @default(0)
  viewsCount      Int         @default(0)
  likesCount      Int         @default(0)
  sharesCount     Int         @default(0)
  commentsCount   Int         @default(0)
  /// Decryptability health. `error` is server-confirmed (report-error route
  /// re-decrypts before flipping) and blocks the viewer page until an admin
  /// clears it. Distinct from Product.productStatus.
  status          MediaStatus @default(ok)
  /// Last integrity-failure reason (allowlisted code). Null when status=ok.
  statusReason    String?
  statusChangedAt DateTime?
  deletedAt       DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  channel           Channel        @relation(fields: [channelId], references: [id], onDelete: Restrict)
  directSaleProduct Product?       @relation("MediaDirectSaleProduct")
  envelope          MediaEnvelope?
  mediaProducts     MediaProduct[]
  comments          Comment[]
  images            MediaImage[]

  @@index([channelId, position])
  @@index([channelId, viewsCount(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([channelId, status])
}

/// MediaEnvelope — ciphertext-at-rest for ALL media content (AES-256-GCM with
/// a per-media DEK, no AAD). Exactly one per Media: the envelope holds the
/// encrypted payload — the source URL for url media, the content bytes for
/// photo/article. `wrappedDek` is the per-media DEK wrapped under CONTENT_KEK
/// (operator recovery: rotation + admin preview, no SatsRail old_key needed).
///
/// mediaId is nullable because photo uploads stage the envelope (via
/// /api/admin/photos) before the Media row exists, then link it on save. The
/// @@unique enforces 1:1 for linked rows (Postgres treats multiple NULLs as
/// distinct, so unlinked staged rows don't collide).
///
/// wrappedDek is nullable ONLY for legacy pre-migration url-media rows whose
/// plaintext source was dropped (remediation: re-import / re-save the URL —
/// see scripts/audit-media-envelopes.ts). A CHECK constraint (raw SQL,
/// `MediaEnvelope_linked_has_wrappedDek`, NOT VALID) forbids creating any NEW
/// linked row without a wrapped DEK; Prisma can't express it in this schema.
model MediaEnvelope {
  id         String   @id @default(cuid())
  mediaId    String?  @unique
  bytes      Bytes
  mimeType   String
  wrappedDek String?
  createdAt  DateTime @default(now())

  media Media? @relation(fields: [mediaId], references: [id], onDelete: Cascade)
}

/// MediaImage — unencrypted thumbnail + preview-gallery images for a Media
/// item. Replaces the generic PreviewImage table and the inline Media
/// thumbnail* columns. Distinct from MediaEnvelope, which holds ciphertext.
///
/// A row is exactly one of:
///   byte-backed: bytes + mimeType set, served via /api/images/<id>
///   url-backed:  externalUrl set (imported direct URL, no local bytes)
/// The "exactly one" invariant is enforced by a CHECK constraint (raw SQL in
/// the migration) plus app-level validation.
///
/// mediaId is nullable: gallery/thumbnail images are uploaded through the
/// /api/images shim before the owning Media row exists, then linked on save.
/// Rows left with mediaId = null also keep that shim non-breaking for any
/// non-media upload (channel/settings images still use their own Bytes columns).
model MediaImage {
  id          String         @id @default(cuid())
  mediaId     String?
  kind        MediaImageKind @default(preview)
  bytes       Bytes?
  mimeType    String?
  externalUrl String?
  position    Int            @default(0)
  createdAt   DateTime       @default(now())

  media Media? @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@index([mediaId, kind, position])
}

/// Product — flat mirror of the portal Products table. PrivaPaid never stores
/// the portal product key; only cached display fields and the keyFingerprint.
///
/// Scope: exactly one of channelId/mediaId is set (CHECK constraint applied
/// via raw SQL in the migration). The scope is derived from the portal's
/// external_ref: `ch_N` → channelId, `md_N` → mediaId. PrivaPaid only
/// consumes portal products with one of these two ref shapes.
///
/// Cardinality with MediaProduct:
///   channel-scoped Product → N MediaProduct rows (one per media in the bundle)
///   media-scoped   Product → 1 MediaProduct row  (the direct sale)
model Product {
  id                String  @id @default(cuid())
  /// UUID from SatsRail. Canonical product identifier across the rail.
  satsrailProductId String  @unique
  /// SHA-256 hex of the encryption key, for client-side verification only.
  keyFingerprint    String?

  channelId String?
  mediaId   String? @unique // a media has at most one direct-sale product

  // Cached portal Product fields (denormalized; queried in hot paths)
  productName                  String?
  productPriceCents            Int?
  productCurrency              String?
  productAccessDurationSeconds Int?
  productStatus                String?   @default("active")
  productSlug                  String?
  productExternalRef           String? // "ch_N" or "md_N"
  syncedAt                     DateTime?
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt

  channel       Channel?       @relation(fields: [channelId], references: [id], onDelete: Cascade)
  media         Media?         @relation("MediaDirectSaleProduct", fields: [mediaId], references: [id], onDelete: Cascade)
  mediaProducts MediaProduct[]

  @@index([channelId, productStatus])
  @@index([productStatus])
  @@index([productExternalRef])
}

/// MediaProduct — the per-(product, media) row holding the encrypted media DEK.
/// One row per (productId, mediaId). The same media can be referenced by
/// multiple rows when multiple products unlock it (direct sale + channel
/// access, multiple tiers, etc.). Key rotation re-encrypts each row
/// transactionally; the shared MediaEnvelope bytes never change.
///
/// Patent claim 24 — "one payment → many keys, one per asset" — is embodied
/// here: each row carries its own ciphertext bound to its own product's AES
/// key via AAD = Product.satsrailProductId. It wraps the media DEK (which
/// decrypts the shared MediaEnvelope) rather than the source directly.
model MediaProduct {
  id        String @id @default(cuid())
  productId String
  mediaId   String

  /// AES-256-GCM blob (Base64): IV[12] + ciphertext + auth_tag[16].
  /// AAD = Product.satsrailProductId (UUID string).
  /// Plaintext = the media DEK (base64url). Decrypt with the product key to
  /// recover the DEK, then decrypt MediaEnvelope.bytes with it.
  encryptedDek   String
  keyFingerprint String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  media   Media   @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@unique([productId, mediaId])
  @@index([mediaId])
  @@index([productId])
}

/// Comment — anonymous thread on a media item. No author identity is
/// stored; the macaroon gate at write time is the only authentication.
model Comment {
  id        String   @id @default(cuid())
  mediaId   String
  body      String
  createdAt DateTime @default(now())

  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@index([mediaId, createdAt(sort: Desc)])
}

/// Settings — singleton (enforced by check constraint `id = 1`).
model Settings {
  id                      Int       @id @default(1)
  setupCompleted          Boolean   @default(false)
  setupCompletedAt        DateTime?
  instanceName            String
  instanceDomain          String    @default("localhost:3000")
  nsfwEnabled             Boolean   @default(false)
  adultDisclaimer         String    @default("")
  themePrimary            String    @default("#3b82f6")
  themeBg                 String    @default("#0a0a0a")
  themeBgSecondary        String    @default("#18181b")
  themeText               String    @default("#ededed")
  themeTextSecondary      String    @default("#a1a1aa")
  themeHeading            String    @default("#fafafa")
  themeBorder             String    @default("#27272a")
  themeFont               String    @default("Geist")
  logoUrl                 String    @default("")
  logoBytes               Bytes? // replaces logo_image_id GridFS pointer
  logoMimeType            String?
  aboutText               String    @default("")
  satsrailApiUrl          String    @default("https://satsrail.com/api/v1")
  satsrailApiKeyEncrypted String?
  merchantId              String?
  merchantName            String?
  merchantCurrency        String    @default("USD")
  merchantLocale          String    @default("en")
  googleAnalyticsId       String    @default("")
  googleSiteVerification  String    @default("")
  sentryDsn               String    @default("")
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
}

/// AuditLog — write-only audit trail. App-level cleanup job deletes rows
/// older than 90 days (replaces MongoDB TTL index).
model AuditLog {
  id         String         @id @default(cuid())
  actorId    String
  actorEmail String         @default("")
  actorType  AuditActorType
  action     String
  targetType String         @default("")
  targetId   String         @default("")
  details    Json           @default("{}")
  ip         String         @default("")
  userAgent  String         @default("")
  createdAt  DateTime       @default(now())

  @@index([actorId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@index([targetType, targetId])
  @@index([createdAt]) // for cleanup job
}

/// WebhookEvent — idempotency table for SatsRail webhooks. App-level cleanup
/// job deletes rows older than 7 days (replaces MongoDB TTL index).
model WebhookEvent {
  id          String   @id @default(cuid())
  eventId     String   @unique
  eventType   String
  processedAt DateTime @default(now())

  @@index([processedAt])
}

/// PushSubscription — anonymous, per-browser Web Push address scoped to one
/// Channel. No viewer identity: `endpoint` is the opaque push-service URL the
/// browser minted; `p256dh`/`auth` are the RFC 8291 payload-encryption keys.
/// One row per (browser endpoint × channel) — a browser following N channels
/// has N rows. Operator-owned engagement data; never sent to SatsRail. Opt-in
/// only (explicit click + browser permission), PII-free (no email/account/UA).
/// Dead endpoints are pruned on 404/410 at send time.
model PushSubscription {
  id         String   @id @default(cuid())
  channelId  String
  endpoint   String
  p256dh     String
  auth       String
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, endpoint])
  @@index([channelId])
}
