# =============================================================================
# Media App — Docker Environment Configuration
# =============================================================================
# Copy this file to .env, then run:
#
#   cp .env.docker.example .env
#   docker compose up -d
#
# Visit http://localhost:3000 to complete setup via the browser wizard.
# Secrets (NEXTAUTH_SECRET, SK_ENCRYPTION_KEY) are auto-generated on first run.
# =============================================================================

# --- PostgreSQL (Docker Compose service) -------------------------------------
POSTGRES_USER=privapaid
POSTGRES_PASSWORD=change-this-before-deploying
POSTGRES_DB=privapaid
DATABASE_URL=postgresql://privapaid:change-this-before-deploying@postgres:5432/privapaid?schema=public

# --- NextAuth -----------------------------------------------------------------
NEXTAUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
# NEXTAUTH_SECRET is auto-generated if not set. Override here for production:
# NEXTAUTH_SECRET=your-secret-here

# --- Optional Overrides -------------------------------------------------------
# These are configured via the setup wizard. Set here only to override.
# INSTANCE_NAME=MyMediaApp
# NSFW_ENABLED=false
# THEME_PRIMARY=#3b82f6
# SATSRAIL_API_URL=https://app.satsrail.com/api/v1
# SK_ENCRYPTION_KEY=your-32-byte-hex-key
# SATSRAIL_WEBHOOK_SECRET=your-webhook-secret

# Optional encrypted protected MP4 storage (absolute, private, persistent).
# Docker Compose already mounts /app/data; never use public/ here.
# PRIVATE_VIDEO_DIR=/app/data/private-videos

# Protected-video hardening (defaults shown; limits are per app process).
# PRIVATE_VIDEO_MIN_FREE_MB=1024
# PRIVATE_VIDEO_MAX_STREAMS=16
# FFPROBE_PATH=/usr/bin/ffprobe

# Video ingestion is off by default. See VIDEO_INGESTION.md and VIDEO_FOUNDATIONS.md.
VIDEO_PIPELINE_ENABLED=false
# To opt in, set true and run: docker compose --profile video up -d --build
# The SAME explicit CONTENT_KEK must be supplied to app and worker. For an
# existing installation, use its persisted key; never generate a replacement.
# CONTENT_KEK=<existing-or-new-32-byte-base64-key>
VIDEO_STORAGE_PROVIDER=local
VIDEO_LOCAL_ROOT=/app/data/video-pipeline
VIDEO_JOB_LEASE_SECONDS=60
# Worker also needs the same SK_ENCRYPTION_KEY used by the web app for Settings.
# VIDEO_MAX_STORAGE_BYTES=107374182400
# VIDEO_MAX_PENDING_JOBS=4
# VIDEO_MAX_ACTIVE_TRANSFERS=2
# VIDEO_MAX_DURATION_SECONDS=14400
# VIDEO_ENCODING_THREADS=2
# VIDEO_ENCODING_TIMEOUT_SECONDS=28800
# VIDEO_STAGING_RETENTION_SECONDS=86400
# VIDEO_MIN_FREE_BYTES=1073741824
# FFMPEG_PATH=/usr/bin/ffmpeg
# S3 alternative: credentials via workload IAM role or standard AWS env vars.
# VIDEO_STORAGE_PROVIDER=s3
# VIDEO_S3_BUCKET=your-private-bucket
# VIDEO_S3_REGION=us-east-1
# VIDEO_S3_PREFIX=privapaid-video/
# VIDEO_S3_ENDPOINT=https://your-s3-compatible-provider.example
# VIDEO_S3_PATH_STYLE=false

# Paid segmented playback is a separate opt-in. See VIDEO_PLAYBACK.md.
VIDEO_PLAYBACK_ENABLED=false
# Production uses a dedicated sibling HTTPS media hostname and AWS CloudFront.
# VIDEO_DELIVERY_PROVIDER=cloudfront
# VIDEO_MEDIA_ORIGIN=https://media.example.com
# VIDEO_CLOUDFRONT_KEY_PAIR_ID=<CloudFront public key ID>
# VIDEO_DELIVERY_PRIVATE_KEY=<complete RSA-2048 private PEM from secret manager>
# VIDEO_DELIVERY_TTL_SECONDS=300
