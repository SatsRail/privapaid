FROM node:22-alpine AS build
WORKDIR /app
RUN apk add --no-cache openssl
RUN npm install -g npm@11
COPY package.json package-lock.json ./
COPY prisma ./prisma
RUN npm ci --ignore-scripts && npx prisma generate
COPY tsconfig.json ./
COPY src/lib ./src/lib
COPY src/workers ./src/workers
COPY src/config ./src/config
RUN npm run build:video-worker && npm prune --omit=dev --ignore-scripts

FROM node:22-alpine AS runner
WORKDIR /app
RUN apk add --no-cache openssl ffmpeg
ENV NODE_ENV=production
RUN addgroup --system --gid 1001 nodejs && adduser --system --uid 1001 worker && \
    mkdir -p /app/data && chown worker:nodejs /app/data
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/build ./build
USER worker
HEALTHCHECK --interval=15s --timeout=5s --start-period=30s CMD ["node", "build/video-worker.cjs", "--healthcheck"]
CMD ["node", "build/video-worker.cjs"]
