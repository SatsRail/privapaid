{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Opt-in PrivaPaid encrypted video: private S3 output, signed CloudFront cookies and first-party grant bootstrap. No SatsRail media integration.",
  "Parameters": {
    "AppHostname": {
      "Type": "String",
      "Description": "Public HTTPS PrivaPaid hostname, e.g. watch.example.com; also used as the application origin.",
      "AllowedPattern": "[a-z0-9][a-z0-9.-]+"
    },
    "MediaHostname": {
      "Type": "String",
      "Description": "Dedicated sibling HTTPS hostname, e.g. media.example.com. Must share the same registrable domain as AppHostname.",
      "AllowedPattern": "[a-z0-9][a-z0-9.-]+"
    },
    "CertificateArn": {
      "Type": "String",
      "Description": "ACM certificate in us-east-1 covering MediaHostname."
    },
    "SigningPublicKey": {
      "Type": "String",
      "Description": "PEM RSA-2048 public key. Keep its private key only in PrivaPaid secret configuration."
    },
    "StoragePrefix": {
      "Type": "String",
      "Default": "privapaid-video/",
      "AllowedPattern": "[A-Za-z0-9_/-]{1,128}/"
    },
    "HostedZoneId": {
      "Type": "String",
      "Default": "",
      "Description": "Optional Route 53 hosted zone ID; otherwise create the media DNS alias yourself."
    }
  },
  "Conditions": {
    "CreateDNS": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "HostedZoneId"
            },
            ""
          ]
        }
      ]
    }
  },
  "Resources": {
    "Bucket": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "OwnershipControls": {
          "Rules": [
            {
              "ObjectOwnership": "BucketOwnerEnforced"
            }
          ]
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "LifecycleConfiguration": {
          "Rules": [
            {
              "Id": "AbortIncompleteMultipart",
              "Status": "Enabled",
              "AbortIncompleteMultipartUpload": {
                "DaysAfterInitiation": 7
              }
            }
          ]
        }
      }
    },
    "OAC": {
      "Type": "AWS::CloudFront::OriginAccessControl",
      "Properties": {
        "OriginAccessControlConfig": {
          "Name": {
            "Fn::Sub": "${AWS::StackName}-video"
          },
          "OriginAccessControlOriginType": "s3",
          "SigningBehavior": "always",
          "SigningProtocol": "sigv4"
        }
      }
    },
    "PublicKey": {
      "Type": "AWS::CloudFront::PublicKey",
      "Properties": {
        "PublicKeyConfig": {
          "CallerReference": {
            "Fn::Sub": "${AWS::StackName}-video"
          },
          "Name": {
            "Fn::Sub": "${AWS::StackName}-video"
          },
          "EncodedKey": {
            "Ref": "SigningPublicKey"
          }
        }
      }
    },
    "KeyGroup": {
      "Type": "AWS::CloudFront::KeyGroup",
      "Properties": {
        "KeyGroupConfig": {
          "Name": {
            "Fn::Sub": "${AWS::StackName}-video"
          },
          "Items": [
            {
              "Ref": "PublicKey"
            }
          ]
        }
      }
    },
    "CipherCache": {
      "Type": "AWS::CloudFront::CachePolicy",
      "Properties": {
        "CachePolicyConfig": {
          "Name": {
            "Fn::Sub": "${AWS::StackName}-ciphertext"
          },
          "DefaultTTL": 86400,
          "MaxTTL": 31536000,
          "MinTTL": 0,
          "ParametersInCacheKeyAndForwardedToOrigin": {
            "EnableAcceptEncodingGzip": false,
            "EnableAcceptEncodingBrotli": false,
            "CookiesConfig": {
              "CookieBehavior": "none"
            },
            "HeadersConfig": {
              "HeaderBehavior": "none"
            },
            "QueryStringsConfig": {
              "QueryStringBehavior": "none"
            }
          }
        }
      }
    },
    "NoCache": {
      "Type": "AWS::CloudFront::CachePolicy",
      "Properties": {
        "CachePolicyConfig": {
          "Name": {
            "Fn::Sub": "${AWS::StackName}-grant-no-cache"
          },
          "DefaultTTL": 0,
          "MaxTTL": 0,
          "MinTTL": 0,
          "ParametersInCacheKeyAndForwardedToOrigin": {
            "EnableAcceptEncodingGzip": false,
            "CookiesConfig": {
              "CookieBehavior": "none"
            },
            "HeadersConfig": {
              "HeaderBehavior": "none"
            },
            "QueryStringsConfig": {
              "QueryStringBehavior": "none"
            }
          }
        }
      }
    },
    "GrantOriginPolicy": {
      "Type": "AWS::CloudFront::OriginRequestPolicy",
      "Properties": {
        "OriginRequestPolicyConfig": {
          "Name": {
            "Fn::Sub": "${AWS::StackName}-grant-origin"
          },
          "CookiesConfig": {
            "CookieBehavior": "none"
          },
          "QueryStringsConfig": {
            "QueryStringBehavior": "none"
          },
          "HeadersConfig": {
            "HeaderBehavior": "whitelist",
            "Headers": [
              "Origin",
              "Content-Type",
              "Access-Control-Request-Method",
              "Access-Control-Request-Headers"
            ]
          }
        }
      }
    },
    "CipherHeaders": {
      "Type": "AWS::CloudFront::ResponseHeadersPolicy",
      "Properties": {
        "ResponseHeadersPolicyConfig": {
          "Name": {
            "Fn::Sub": "${AWS::StackName}-cipher-headers"
          },
          "CorsConfig": {
            "AccessControlAllowCredentials": true,
            "AccessControlAllowOrigins": {
              "Items": [
                {
                  "Fn::Sub": "https://${AppHostname}"
                }
              ]
            },
            "AccessControlAllowMethods": {
              "Items": [
                "GET",
                "HEAD",
                "OPTIONS"
              ]
            },
            "AccessControlAllowHeaders": {
              "Items": [
                "Range"
              ]
            },
            "OriginOverride": true
          },
          "SecurityHeadersConfig": {
            "ContentTypeOptions": {
              "Override": true
            },
            "ReferrerPolicy": {
              "ReferrerPolicy": "no-referrer",
              "Override": true
            },
            "StrictTransportSecurity": {
              "AccessControlMaxAgeSec": 31536000,
              "Override": true
            }
          }
        }
      }
    },
    "Distribution": {
      "Type": "AWS::CloudFront::Distribution",
      "Properties": {
        "DistributionConfig": {
          "Enabled": true,
          "HttpVersion": "http2and3",
          "IPV6Enabled": true,
          "Aliases": [
            {
              "Ref": "MediaHostname"
            }
          ],
          "ViewerCertificate": {
            "AcmCertificateArn": {
              "Ref": "CertificateArn"
            },
            "SslSupportMethod": "sni-only",
            "MinimumProtocolVersion": "TLSv1.2_2021"
          },
          "Origins": [
            {
              "Id": "ciphertext",
              "DomainName": {
                "Fn::GetAtt": [
                  "Bucket",
                  "RegionalDomainName"
                ]
              },
              "S3OriginConfig": {
                "OriginAccessIdentity": ""
              },
              "OriginAccessControlId": {
                "Ref": "OAC"
              }
            },
            {
              "Id": "grant",
              "DomainName": {
                "Ref": "AppHostname"
              },
              "CustomOriginConfig": {
                "OriginProtocolPolicy": "https-only",
                "OriginSSLProtocols": [
                  "TLSv1.2"
                ],
                "HTTPSPort": 443
              }
            }
          ],
          "DefaultCacheBehavior": {
            "TargetOriginId": "ciphertext",
            "ViewerProtocolPolicy": "https-only",
            "AllowedMethods": [
              "GET",
              "HEAD"
            ],
            "CachedMethods": [
              "GET",
              "HEAD"
            ],
            "TrustedKeyGroups": [
              {
                "Ref": "KeyGroup"
              }
            ],
            "CachePolicyId": {
              "Ref": "CipherCache"
            },
            "ResponseHeadersPolicyId": {
              "Ref": "CipherHeaders"
            },
            "Compress": false
          },
          "CacheBehaviors": [
            {
              "PathPattern": "/api/video-delivery/grant",
              "TargetOriginId": "grant",
              "ViewerProtocolPolicy": "https-only",
              "AllowedMethods": [
                "GET",
                "HEAD",
                "OPTIONS",
                "PUT",
                "PATCH",
                "POST",
                "DELETE"
              ],
              "CachedMethods": [
                "GET",
                "HEAD"
              ],
              "CachePolicyId": {
                "Ref": "NoCache"
              },
              "OriginRequestPolicyId": {
                "Ref": "GrantOriginPolicy"
              },
              "Compress": false
            }
          ],
          "CustomErrorResponses": [
            {
              "ErrorCode": 403,
              "ErrorCachingMinTTL": 0
            },
            {
              "ErrorCode": 404,
              "ErrorCachingMinTTL": 0
            }
          ]
        }
      }
    },
    "BucketPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "Bucket"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "TLSOnly",
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "Bucket",
                    "Arn"
                  ]
                },
                {
                  "Fn::Sub": "${Bucket.Arn}/*"
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            },
            {
              "Sid": "CDNOutputOnly",
              "Effect": "Allow",
              "Principal": {
                "Service": "cloudfront.amazonaws.com"
              },
              "Action": "s3:GetObject",
              "Resource": {
                "Fn::Sub": "${Bucket.Arn}/${StoragePrefix}assets/*/versions/*/attempts/*"
              },
              "Condition": {
                "StringEquals": {
                  "AWS:SourceArn": {
                    "Fn::Sub": "arn:${AWS::Partition}:cloudfront::${AWS::AccountId}:distribution/${Distribution}"
                  }
                }
              }
            }
          ]
        }
      }
    },
    "WorkerPolicy": {
      "Type": "AWS::IAM::ManagedPolicy",
      "Properties": {
        "Description": "Attach to the PrivaPaid worker/application workload role; no access keys are created.",
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": [
                "s3:ListBucket"
              ],
              "Resource": {
                "Fn::GetAtt": [
                  "Bucket",
                  "Arn"
                ]
              },
              "Condition": {
                "StringLike": {
                  "s3:prefix": [
                    {
                      "Fn::Sub": "${StoragePrefix}*"
                    }
                  ]
                }
              }
            },
            {
              "Effect": "Allow",
              "Action": [
                "s3:GetObject",
                "s3:PutObject",
                "s3:DeleteObject",
                "s3:AbortMultipartUpload",
                "s3:ListMultipartUploadParts"
              ],
              "Resource": {
                "Fn::Sub": "${Bucket.Arn}/${StoragePrefix}*"
              }
            }
          ]
        }
      }
    },
    "DNS": {
      "Type": "AWS::Route53::RecordSet",
      "Condition": "CreateDNS",
      "Properties": {
        "HostedZoneId": {
          "Ref": "HostedZoneId"
        },
        "Name": {
          "Ref": "MediaHostname"
        },
        "Type": "A",
        "AliasTarget": {
          "DNSName": {
            "Fn::GetAtt": [
              "Distribution",
              "DomainName"
            ]
          },
          "HostedZoneId": "Z2FDTNDATAQYW2"
        }
      }
    }
  },
  "Outputs": {
    "Bucket": {
      "Value": {
        "Ref": "Bucket"
      }
    },
    "Region": {
      "Value": {
        "Ref": "AWS::Region"
      }
    },
    "StoragePrefix": {
      "Value": {
        "Ref": "StoragePrefix"
      }
    },
    "MediaOrigin": {
      "Value": {
        "Fn::Sub": "https://${MediaHostname}"
      }
    },
    "DistributionDomain": {
      "Value": {
        "Fn::GetAtt": [
          "Distribution",
          "DomainName"
        ]
      }
    },
    "KeyPairId": {
      "Value": {
        "Ref": "PublicKey"
      }
    },
    "WorkerPolicyArn": {
      "Value": {
        "Ref": "WorkerPolicy"
      }
    }
  }
}
